# 本地出刊密钥模板 —— 复制成 .env.local 后填入真实值（.env.local 已被 gitignore，不会入库）
#
#   Windows 命令：copy .env.example .env.local
#   然后编辑 .env.local，把 sk-xxxx 换成你的真实 Key
#
# 只有 LLM_API_KEY 是必填；下面两个不填就用默认值（DeepSeek）。

LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
