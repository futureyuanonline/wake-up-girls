<meta charset="utf-8" />
<title>Wake Up Girls · 刊物体例</title>
<style>
  @page { size: A4; margin: 1.9cm 1.8cm 1.6cm 1.8cm; }
  body { font-family: "Microsoft YaHei", "微软雅黑", sans-serif; font-size: 10.5pt; line-height: 1.72; color: #1D1715; }
  h1 { font-size: 17pt; margin: 0 0 3pt 0; }
  .sub { font-size: 9.5pt; color: #5A4F49; margin: 0 0 14pt 0; }
  h2 { font-size: 12pt; margin: 16pt 0 7pt 0; padding-bottom: 3pt; border-bottom: 1.2pt solid #A12627; color: #A12627; }
  h3 { font-size: 10.5pt; margin: 11pt 0 3pt 0; }
  p { margin: 3pt 0; }
  ul, ol { margin: 3pt 0; padding-left: 16pt; }
  li { margin: 2pt 0; }
  table { border-collapse: collapse; width: 100%; margin: 5pt 0; }
  th, td { border: 0.75pt solid #DAD4C8; padding: 4pt 6pt; font-size: 9.5pt; vertical-align: top; }
  th { background: #F1E9D9; text-align: left; }
  .box { background: #FBF3E6; border-left: 3pt solid #A12627; padding: 8pt 11pt; margin: 9pt 0; font-size: 9.5pt; }
  .num { font-size: 20pt; font-weight: bold; color: #A12627; letter-spacing: 1pt; }
  code { font-family: Consolas, monospace; font-size: 9pt; background: #F4F1EA; padding: 0 2pt; }
  .small { font-size: 9pt; color: #6B5F58; }
</style>
